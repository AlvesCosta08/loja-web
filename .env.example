# =====================================================================
# Loja Web — variáveis de ambiente
#
# Uso local:
#   cp .env.example .env
#   npm run dev
#
# ⚠️ Variáveis VITE_* são embutidas no bundle final (build-time).
#    Nunca coloque segredos aqui — só URLs públicas.
# =====================================================================

# ----- Backend API -----
# Local (dev server do Vite na porta 5173 → API na 8080)
VITE_API_URL=http://localhost:8080

# Render (defina no dashboard do Static Site):
# VITE_API_URL=https://loja-api.onrender.com


# =====================================================================
# RENDER — configuração recomendada no dashboard do Static Site
# =====================================================================
#
# VITE_API_URL=https://loja-api.onrender.com
#
# Observações:
#   1. VITE_* é build-time, não runtime. Ao alterar, precisa REBUILD.
#   2. O Static Site precisa do rewrite /* → /index.html (SPA fallback).
#   3. O CORS_ALLOWED_ORIGINS do backend precisa incluir a URL do front.
# =====================================================================